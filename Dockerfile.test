# The test environment: WeasyPrint needs Pango, which macOS lacks. Run it through the Makefile.
#
#   make test             pytest with coverage, in the "test" stage
#   make visual           the visual regression bench, in the "visual" stage
#
# BASE selects the Python version, for example python:3.10-slim-trixie.
ARG BASE=python:3.15-slim-trixie@sha256:2da676046630d7bf14c6764ae1143dc7fa0377a53f94bf5a642f0b214aca5bce

FROM ghcr.io/astral-sh/uv:0.13.4@sha256:9f130421e930bfbdc563c00740466603f8723158e90297d07957c2294640262b AS uv

FROM ${BASE} AS test
# Pango for WeasyPrint, and the fonts the tests assume. On PyPy a compiler too: zopfli, which
# WeasyPrint needs through fonttools[woff], has no PyPy wheel.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 \
        fonts-dejavu-core fonts-liberation fonts-noto-color-emoji \
        $(if command -v pypy3 > /dev/null; then echo gcc g++ libc6-dev; fi) \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /uvx /usr/local/bin/
# The environment lives outside the mounted source, so it never clashes with a host .venv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/opt/uv-cache
WORKDIR /src
# Only the dependency files: an edit of the README must not rebuild the environment
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --all-extras --no-install-project
CMD ["uv", "run", "--frozen", "--all-extras", "pytest", "--cov", "--cov-report=term-missing", "--cov-report=xml"]

FROM test AS visual
# The fonts of the weasyprint-service image. Chromium prints the references in this same image.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        fonts-dejavu fonts-freefont-ttf fonts-ipafont-gothic fonts-noto-cjk \
        fonts-tlwg-loma-otf fonts-unifont fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*
# Trebuchet MS, the first font Mermaid asks for: Safari has it, the service image does not. The package of
# Debian contrib downloads the core fonts of Microsoft at build time. Only Trebuchet MS stays: Arial and
# Times New Roman would take over Helvetica and Times from the Liberation fonts of the service image.
RUN sed -i 's/^Components: main$/Components: main contrib/' /etc/apt/sources.list.d/debian.sources \
    && echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections \
    && apt-get update \
    && apt-get install --yes --no-install-recommends ttf-mscorefonts-installer \
    && find /usr/share/fonts/truetype/msttcorefonts -type f ! -iname 'trebuc*' -delete \
    && fc-cache --force \
    && fc-list | grep -qi "trebuchet ms" \
    && test "$(fc-match Helvetica family)" = "Liberation Sans" \
    && rm -rf /var/lib/apt/lists/*
# The fonts the corpus asks for by name (Noto Sans, Amiri, Mplus 1p...), the very files of the resvg suite,
# live in corpus/fonts of the mounted source: Chromium, WeasyPrint and resvg all find them through fontconfig
RUN printf '<?xml version="1.0"?>\n<!DOCTYPE fontconfig SYSTEM "fonts.dtd">\n<fontconfig><dir>/src/corpus/fonts</dir></fontconfig>\n' \
    > /etc/fonts/conf.d/99-weasysvg-corpus.conf
# The headless Chromium of Playwright, for make references, with the libraries it needs
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN uv run --frozen --all-extras --no-sync playwright install --with-deps --only-shell chromium \
    && rm -rf /var/lib/apt/lists/*
CMD ["uv", "run", "--frozen", "--all-extras", "python", "tools/visual/bench.py"]
